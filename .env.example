# Language model provider (reserved for analysis/chat stages)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RAG_CHAT_MODEL=deepseek-v4-flash
OPENAI_CHAT_MODEL=gpt-4o-mini

# Retrieval tuning
RAG_MATCH_THRESHOLD=0.32
RAG_MATCH_COUNT=14
RAG_MAX_CONTEXT_TOKENS=7000
RAG_MAX_OUTPUT_TOKENS=4000
SUMMARY_MAX_OUTPUT_TOKENS=7000

# Document embeddings. Use "local" now and "openai" after adding credits.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OCR languages used by Tesseract.js.
OCR_LANGUAGES=eng+amh
