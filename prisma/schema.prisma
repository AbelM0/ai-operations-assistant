generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// USERS
// =========================================================

model User {
  id        String  @id @default(uuid()) @db.Uuid
  clerkId   String  @unique @map("clerk_id")
  email     String  @unique
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  fullName  String? @map("full_name")
  imageUrl  String? @map("image_url")

  name      String?
  avatarUrl String?

  languagePreference String  @default("en")
  timezone           String?
  currency           String  @default("ETB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents           Document[]
  documentExtractions DocumentExtraction[]
  conversations       Conversation[]
  expenseEntries      ExpenseEntry[]
  expenseSummaries    ExpenseSummary[]
  aiUsage             AIUsage[]
  auditLogs           AuditLog[]

  @@map("users")
}

// =========================================================
// DOCUMENTS
// =========================================================

enum DocumentStatus {
  UPLOADED

  OCR_PROCESSING
  OCR_COMPLETED

  CHUNKING

  EMBEDDING

  READY

  FAILED
}

enum DocumentType {
  INVOICE
  RECEIPT
  CONTRACT
  OTHER
}

enum ExtractionReviewStatus {
  PROCESSING
  SUGGESTED
  NEEDS_REVIEW
  CONFIRMED
  FAILED
}

model Document {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalName String
  storagePath  String

  mimeType  String
  sizeBytes Int

  pageCount Int?

  status DocumentStatus @default(UPLOADED)

  parserUsed String?
  ocrEngine  String?

  fileHash String?  @unique
  tags     String[] @default([])

  errorMessage String?

  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  processingDurationMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks                DocumentChunk[]
  summaries             DocumentSummary[]
  extraction            DocumentExtraction?
  conversations         Conversation[]
  conversationDocuments ConversationDocument[]
  expenseEntries        ExpenseEntry[]
  aiJobs                AIJob[]

  @@index([userId])
  @@index([status])
  @@map("documents")
}

// =========================================================
// STRUCTURED DOCUMENT EXTRACTION
// =========================================================

model DocumentExtraction {
  id String @id @default(uuid()) @db.Uuid

  documentId String   @unique @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType             DocumentType
  classificationConfidence Float
  schemaVersion            String                 @default("invoice-receipt-v1")
  fields                   Json
  reviewStatus             ExtractionReviewStatus @default(PROCESSING)

  provider     String?
  model        String?
  errorMessage String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseEntry ExpenseEntry?

  @@index([userId])
  @@index([reviewStatus])
  @@index([documentType])
  @@map("document_extractions")
}

// =========================================================
// DOCUMENT CHUNKS
// =========================================================

model DocumentChunk {
  id String @id @default(uuid()) @db.Uuid

  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int

  pageNumber Int?

  startOffset Int?
  endOffset   Int?

  tokenCount Int?

  textContent String

  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())

  messageSources MessageSource[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

// =========================================================
// DOCUMENT SUMMARY
// =========================================================

model DocumentSummary {
  id String @id @default(uuid()) @db.Uuid

  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  summary String

  language String @default("en")

  provider String?
  model    String?

  createdAt DateTime @default(now())

  @@map("document_summaries")
}

// =========================================================
// CONVERSATIONS
// =========================================================

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String?   @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  title String @default("New Conversation")

  archived Boolean @default(false)

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  documents ConversationDocument[]

  @@index([userId])
  @@index([documentId])
  @@map("conversations")
}

model ConversationDocument {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([conversationId, documentId])
  @@index([documentId])
  @@map("conversation_documents")
}

// =========================================================
// MESSAGES
// =========================================================

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role MessageRole

  content String

  language String @default("en")

  model String?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  responseTimeMs Int?

  createdAt DateTime @default(now())

  sources MessageSource[]

  @@index([conversationId])
  @@map("messages")
}

// =========================================================
// MESSAGE SOURCES (RAG)
// =========================================================

model MessageSource {
  id String @id @default(uuid()) @db.Uuid

  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  chunkId String        @db.Uuid
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  similarity  Float?
  sourceId    String?
  sourceOrder Int?

  @@index([messageId])
  @@index([chunkId])
  @@map("message_sources")
}

// =========================================================
// AI JOBS
// =========================================================

enum AIJobType {
  OCR
  EMBEDDING
  SUMMARY
  CHAT
  EXPENSE_EXTRACTION
}

enum AIJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model AIJob {
  id String @id @default(uuid()) @db.Uuid

  documentId String?   @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type AIJobType

  status AIJobStatus @default(PENDING)

  progress Int @default(0)

  errorMessage String?

  startedAt DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([type])
  @@map("ai_jobs")
}

// =========================================================
// AI USAGE
// =========================================================

model AIUsage {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String

  model String

  promptTokens Int

  completionTokens Int

  totalTokens Int

  estimatedCost Decimal @db.Decimal(10, 5)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("ai_usage")
}

// =========================================================
// EXPENSES
// =========================================================

enum ExpenseCategory {
  OFFICE
  TRANSPORT
  UTILITIES
  FUEL
  RENT
  SALARY
  FOOD
  OTHER
}

model ExpenseEntry {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String?   @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  extractionId String?             @unique @db.Uuid
  extraction   DocumentExtraction? @relation(fields: [extractionId], references: [id], onDelete: SetNull)

  vendor String

  amount Decimal @db.Decimal(12, 2)

  currency String @default("ETB")

  date DateTime

  category ExpenseCategory @default(OTHER)

  description String?

  confidence Float?

  sourceText String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@map("expense_entries")
}

// =========================================================
// EXPENSE SUMMARY
// =========================================================

model ExpenseSummary {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime

  periodEnd DateTime

  totalAmount Decimal @db.Decimal(14, 2)

  vendorCount Int

  categoryBreakdown Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("expense_summaries")
}

// =========================================================
// AUDIT LOG
// =========================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action String

  resource String

  resourceId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}
